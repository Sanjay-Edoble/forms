{
    "name": "edoble/forms",
    "description": "Edoble Forms — Production-ready form builder and live data sheet platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.6",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "config": {
        "optimize-autoloader": true,
