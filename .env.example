# ─── Edoble Forms Configuration ───

APP_NAME="Edoble Forms"
APP_URL=https://forms.edoble.in
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# ─── Edobase API ───
EDOBASE_URL=https://db.edoble.in/api/v1
EDOBASE_PUBLIC_KEY=edb_pk_your_public_key_here
EDOBASE_SECRET_KEY=edb_sk_your_secret_key_here

# ─── Session ───
SESSION_LIFETIME=120
SESSION_SECURE=true

# ─── Admin ───
ADMIN_EMAILS=admin@edoble.in

# ─── Mail ───
MAIL_FROM_NAME="Edoble Forms"
MAIL_FROM_ADDRESS=noreply@edoble.in
